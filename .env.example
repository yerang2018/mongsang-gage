# 이 파일을 복사해 .env.local 을 만들고 값을 채우세요. 이 파일에는 진짜 키를 넣지 마세요.

# [1단계] Supabase (로그인·DB) — Project URL 과 Publishable key
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# 서버 전용 비밀 키 (sb_secret_...). 절대 공유·커밋 금지
SUPABASE_SECRET_KEY=

# [2단계] Gemini (해몽 글·받아쓰기)
GEMINI_API_KEY=
# (선택) 시도할 모델 순서를 바꿀 때만. 쉼표로 구분 (기본값은 src/lib/gemini.ts)
GEMINI_MODELS=

# [v3] 구슬 충전 (2026-11-03)
# 관리자 화면(/admin)에 들어갈 이메일 (쉼표로 여러 개). 이메일로 로그인한 계정만 해당
ADMIN_EMAILS=
# 카카오페이 송금 링크 (카카오톡 → 카카오페이 → 송금 → 송금 코드/링크). 비우면 충전 화면에 "준비 중"
NEXT_PUBLIC_KAKAOPAY_SEND_URL=

# 따로 넣지 않는 값: VERCEL_ENV·VERCEL_PROJECT_PRODUCTION_URL 은 Vercel이 자동으로 채움
# (행동 기록·AI 기록의 app_env 와 카톡 미리보기 주소에 씀. 내 컴퓨터에선 development)

# [3단계] OpenAI (그림)
OPENAI_API_KEY=
# 1이면 그림 API 대신 임시 그림 사용 (비용 0)
MOCK_IMAGES=
